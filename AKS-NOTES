  }
}

variable "ami" {
  default = "ami-07a00cf47dbbc844c"
}

variable "instance_type" {
  default = "t2.micro"
}

variable "tags" {
  default = { Name = "sagar-web" }
}


[root@master ec2_webserver]# vi provider.tf
[root@master ec2_webserver]# cat provider.tf
